{
  "name": "personal-mail-hub",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted personal mail hub.",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "admin": "npm run admin --workspace=@mail-hub/admin",
    "backup": "sh deploy/backup.sh",
    "deploy:access": "node deploy/access-check.mjs",
    "deploy:verify": "node deploy/verify-deployment.mjs",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@mail-hub/database",
    "db:migrate": "npm run db:migrate --workspace=@mail-hub/database",
    "dev": "npm run dev --workspace=@mail-hub/web",
    "dev:api": "npm run dev --workspace=@mail-hub/api",
    "dev:worker": "npm run dev --workspace=@mail-hub/worker",
    "eval:classify": "npm run eval:classify --workspace=@mail-hub/admin --",
    "eval:home": "npm run eval:home --workspace=@mail-hub/admin --",
    "verify:classify": "npm run verify:classify --workspace=@mail-hub/admin --",
    "preflight": "node deploy/preflight.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "validate:tasks": "node scripts/validate-tasks.mjs",
    "restore": "sh deploy/restore.sh",
    "start": "npm run start --workspace=@mail-hub/api",
    "start:worker": "npm run start --workspace=@mail-hub/worker",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "github-slugger": "2.0.0",
    "typescript": "5.9.3"
  }
}
