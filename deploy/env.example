# Copy to .env beside docker-compose.yml and fill in every value.
# Generate the secrets:
#   RECOVERY_GENERATION: uuidgen
#   CREDENTIALS_KEY:     openssl rand -base64 32
#   POSTGRES_PASSWORD:   openssl rand -base64 24

# PostgreSQL password for the mail_hub role the api and worker connect with.
POSTGRES_PASSWORD=

# Recovery generation (SPEC.md section 10): a random UUID from deployment
# configuration. Keep it across ordinary restarts and releases. Set a new
# value for every restore. Never recover it from the database or a backup.
RECOVERY_GENERATION=

# Key that seals stored mailbox passwords (AES-256-GCM, 32 bytes, base64 or
# hex). Back it up separately from the database: losing it loses every stored
# credential, and a wrong key cannot open them.
CREDENTIALS_KEY=

# Deployed HTTPS origin of the application, for example
# https://mail.example.com. Passkey ceremonies and origin checks use it.
# For a local compose trial without TLS, set an http://localhost origin and
# PREFLIGHT_ALLOW_HTTP=1.
BASE_URL=
PREFLIGHT_ALLOW_HTTP=

# Host port the web gateway listens on.
WEB_PORT=8080

# Optional: Jev classification API key. Core mail never waits on it.
TYPE_SAFE_API_KEY=

# Optional: worker schedule overrides (cron). Leave a value empty to keep
# the image default. Image defaults:
#   SYNC_CYCLE_CRON       */30 * * * * *
#   SEND_CYCLE_CRON       */5 * * * * *
#   SENT_COPY_CYCLE_CRON  */15 * * * * *
#   CLASSIFY_CYCLE_CRON   */60 * * * * *
SYNC_CYCLE_CRON=
SEND_CYCLE_CRON=
SENT_COPY_CYCLE_CRON=
CLASSIFY_CYCLE_CRON=
