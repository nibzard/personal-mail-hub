# Operator access configuration for npm run deploy:access. Copy this file
# to deploy/access.env (git ignored) and fill in the values you keep outside
# the repository. Every key is optional; the process environment always wins
# over this file. Keep tokens and private keys out of the repository.

# SSH destination as named in ~/.ssh/config. The default entry is awc-pilot.
# DEPLOY_SSH_HOST=awc-pilot

# Dedicated identity file. The default matches the runbook.
# DEPLOY_SSH_IDENTITY=~/.ssh/id_ed25519_awc_pilot

# Coolify base URL and API token. The check calls GET /api/v1/teams with the
# token; both keys must be set for the check to run. Create the token in the
# Coolify console: Keys & Tokens, with the read role.
# DEPLOY_COOLIFY_URL=https://coolify.example.com
# COOLIFY_TOKEN=

# Deployed HTTPS origin. The access check probes /api/healthz; the verifier
# (npm run deploy:verify) reads the full health report there too.
# DEPLOY_APP_URL=https://mail.example.com

# Compose project label of the deployment, for npm run deploy:verify. The
# default matches deploy/docker-compose.yml (name: mail-hub). A Coolify
# compose resource may use a different project name; read it with
# `docker ps --filter label=com.docker.compose.project=...` on the host.
# DEPLOY_COMPOSE_PROJECT=mail-hub

# Database container override, when the database is not the db service of
# the compose project (for example a separate Coolify PostgreSQL resource).
# Such a resource also carries its own user and database name; set those too.
# DEPLOY_DB_CONTAINER=
# DEPLOY_DB_USER=mail_hub
# DEPLOY_DB_NAME=mail_hub
