# Gateway configuration template for the `web` image target. The official
# nginx image substitutes environment variables into this file at startup;
# only MAIL_HUB_API_HOST needs a value, so nginx's own runtime variables like
# $host are left intact.
#
# One HTTPS origin serves the built PWA and forwards /api to the Fastify
# process with the prefix stripped, the same rewrite the Vite development
# proxy performs. Sessions use same-origin cookies, so the client and the API
# must share this origin. The platform proxy (Coolify) terminates TLS in
# front of this listener.
#
# Baseline security headers (server block below) ride on every response:
# nosniff, no referrers, and a document CSP for the PWA shell. The CSP's
# script hash covers exactly the inline theme bootstrap in
# apps/web/index.html; apps/web/test/gateway-csp.test.ts fails when the two
# drift apart, so editing that script means recomputing the hash here.
# Inline styles are allowed because React sets style attributes and the
# sandboxed reader frame (an about:srcdoc document that inherits this
# policy) renders sender mail with inline styling; data: and https: images
# cover inline message images and reader-requested remote images.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Baseline security headers. nginx drops inherited add_header directives
    # in any location that sets its own, so every location below that adds
    # Cache-Control repeats this block; keep the copies identical.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-KrF3YERYGpK83OR971bdVpx3o5FZTsPVJM69mQpjg/I='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # Compress the text the build serves. `text/html` is always compressed
    # when gzip is on; listing it in gzip_types makes nginx warn, so it stays
    # out. The size floor keeps small responses uncompressed, where the
    # gzip header costs more than it saves.
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;

    # The client reads same-origin /api paths (apps/web/src/lib/api.ts).
    # The trailing slash on proxy_pass strips the /api prefix. Point
    # MAIL_HUB_API_HOST at the app container, for example api:3000.
    location /api/ {
        proxy_pass http://${MAIL_HUB_API_HOST}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        client_max_body_size 50m;
    }

    # Hashed build assets are immutable; the shell itself is not.
    location /assets/ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-KrF3YERYGpK83OR971bdVpx3o5FZTsPVJM69mQpjg/I='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-KrF3YERYGpK83OR971bdVpx3o5FZTsPVJM69mQpjg/I='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header Cache-Control "no-cache";
    }

    # The install descriptor needs its manifest type even where the mime
    # types file predates the extension.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-KrF3YERYGpK83OR971bdVpx3o5FZTsPVJM69mQpjg/I='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header Cache-Control "no-cache";
    }

    # The worker revalidates on every update check, so a new build takes
    # over as soon as the browser looks.
    location = /sw.js {
        default_type text/javascript;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-KrF3YERYGpK83OR971bdVpx3o5FZTsPVJM69mQpjg/I='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header Cache-Control "no-cache";
    }

    # History-friendly PWA fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
