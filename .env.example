# PostgreSQL connection used by the API and worker.
DATABASE_URL=postgres://mail_hub:mail_hub@localhost:5432/mail_hub

# Object storage root. The durable/ subtree holds original MIME bytes,
# uploads, and outbound snapshots: back it up and put it on a persistent
# volume. The cache/ subtree is disposable and regenerable.
STORAGE_ROOT=./data/storage

# API listener settings.
HOST=127.0.0.1
PORT=3000
