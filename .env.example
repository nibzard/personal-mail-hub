# PostgreSQL connection used by the API and worker.
DATABASE_URL=postgres://mail_hub:mail_hub@localhost:5432/mail_hub

# Recovery generation (a UUID) from deployment configuration. Generate a
# random value at installation, keep it across ordinary restarts, and set a
# new value for every restore. Never recover it from the database or backup.
# Missing or mismatched values keep workers and mail mutations blocked.
RECOVERY_GENERATION=

# Object storage root. The durable/ subtree holds original MIME bytes,
# uploads, and outbound snapshots: back it up and put it on a persistent
# volume. The cache/ subtree is disposable and regenerable.
STORAGE_ROOT=./data/storage

# API listener settings.
HOST=127.0.0.1
PORT=3000

# Deployed HTTPS origin of the application, for example
# https://mail.example.com. Passkey authentication checks every WebAuthn
# ceremony against this origin and its hostname, and rejects authenticated
# requests from any other origin. Set it before the first enrollment;
# localhost origins work for development. Leave it empty to keep
# authentication closed.
BASE_URL=
